# API: required unless an alternative is explicitly marked optional.
NODE_ENV=development
# PORT=5000
JWT_SECRET=replace_with_a_long_random_secret

# Use DATABASE_URL instead of the POSTGRES_* values, or fill all POSTGRES_* values.
# DATABASE_URL=postgresql://replace_me
DATABASE_SSL=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=replace_me

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000
# Defaults to true only in development; use false for deployed environments.
# TYPEORM_SYNCHRONIZE=false
# API_PUBLIC_URL=https://replace-me.example

# local is the default. Cloudinary credentials are needed only when IMAGE_STORAGE=cloudinary.
IMAGE_STORAGE=local
# CLOUDINARY_CLOUD_NAME=replace_me
# CLOUDINARY_API_KEY=replace_me
# CLOUDINARY_API_SECRET=replace_me

# Web: NEXT_PUBLIC_API_URL is the only value exposed to browser JavaScript.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional. Set to a strong password to enable the private staging gate.
# STAGING_PASSWORD=replace_with_a_strong_unique_password

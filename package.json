{
  "name": "next-nest-ecommerce-starter",
  "version": "1.0.0",
  "description": "A production-ready, full-stack e-commerce boilerplate. Features a monorepo structure with Next.js, NestJS, PostgreSQL, and Tailwind CSS. Includes a CI/CD pipeline with GitHub Actions.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"pnpm --filter api run start:dev\" \"pnpm --filter web run dev\"",
    "build:api": "cd apps/api && rm -rf documentation && nest build",
    "compodoc": "cd apps/api && compodoc -p tsconfig.json -s",
    "compodoc:build": "cd apps/api && compodoc -p tsconfig.json -d documentation",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikramkharbouch/Next.js-NestJS-E-commerce-Starter.git"
  },
  "author": "Ikram Kharbouch",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ikramkharbouch/Next.js-NestJS-E-commerce-Starter/issues"
  },
  "homepage": "https://github.com/ikramkharbouch/Next.js-NestJS-E-commerce-Starter#readme",
  "devDependencies": {
    "@compodoc/compodoc": "^1.1.31",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.1",
    "concurrently": "^9.2.1",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express@10.4.22>multer": "2.5.0",
      "@nestjs/platform-express@10.4.22>body-parser": "1.20.9",
      "express@4.22.1>body-parser": "1.20.9",
      "express@4.22.1>path-to-regexp": "0.1.13",
      "express@4.22.1>proxy-addr": "2.0.8",
      "express@4.22.1>qs": "6.16.1",
      "body-parser@1.20.9>qs": "6.16.1",
      "glob@10.5.0>minimatch": "9.0.7",
      "ts-node@10.9.2>diff": "4.0.4",
      "@tokenizer/inflate@0.2.7>fflate": "0.8.3"
    }
  }
}
